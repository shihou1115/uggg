# ---- Node / Vite ----
node_modules/
dist/
*.local
.vite/

# ---- Cargo / Tauri ----
src-tauri/target/
src-tauri/gen/schemas/
# crates/ は ugg 本体の workspace に属さない独立 crate 群。target も個別に持つ。
crates/*/target/
**/*.rs.bk

# ---- ログ・実行時生成物 ----
*.log

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/

# ---- 設計検討の作業ファイル（コミットしない） ----
docs/_scratch/

# Python サイドカーのバイトコードキャッシュ
src-tauri/python/__pycache__/

# DnD 導入の作業ディレクトリと旧版の待避先 (v0.5.3)。
# dev では assets_dir がリポジトリ直下になるため、事故で残った分を追跡しない。
.staging/
.previous-*/
